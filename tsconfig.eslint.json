{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts",
    ".*/**/*.ts",
    ".*/**/*.tsx",
    ".*/**/*.mts",
    ".*/**/*.cts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
